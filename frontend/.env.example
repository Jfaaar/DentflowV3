# --- Supabase (frontend + backend) ---
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# --- API base (frontend) ---
# Leave unset in dev to default to http://localhost:3001
# In production, set to your deployed Express API origin.
VITE_API_BASE_URL=

# --- Firebase (only if Phone OTP is enabled; planned to be retired in Phase 3) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
