# --- API base (frontend) ---
# Where the frontend's RTK Query baseApi sends requests. The default
# `docker compose up` stack listens on :4000, so this is what dev wants.
# baseApi tolerates either form (with or without /api/v1 suffix).
VITE_API_BASE_URL=http://localhost:4000

# --- Local Postgres (backend, used by docker-compose) ---
# Override these only if you change docker-compose.yml. Backend's pg pool
# reads DATABASE_URL first; falling back to PG* vars; falling back to
# these defaults.
# PGHOST=localhost
# PGPORT=5432
# PGUSER=dentflow
# PGPASSWORD=dentflow
# PGDATABASE=dentflow
# DATABASE_URL=postgresql://dentflow:dentflow@localhost:5432/dentflow

# --- Backend dev auth bypass ---
# When unset (default), the backend auto-detects: dev bypass turns on
# in non-production when SUPABASE_URL is unset. Set explicitly to
# 'true' or 'false' to override.
# BACKEND_DEV_AUTH=true

# --- Supabase (only when running against a real Supabase project) ---
# Leave these empty for the default local-Postgres dev workflow.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Firebase (only if Phone OTP is enabled; planned to be retired) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
